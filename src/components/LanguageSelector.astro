---
import { getLocalizedPath, locales, localeLabels, type LanguageLink, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  languageLinks?: LanguageLink[];
}

const { locale, languageLinks } = Astro.props;
const currentPath = Astro.url.pathname.replace(/^\/(en|ja|zh)(?=\/|$)/, '') || '/';
const links = languageLinks ?? locales.map((nextLocale) => ({
      locale: nextLocale,
      label: localeLabels[nextLocale],
      href: getLocalizedPath(nextLocale, currentPath),
      current: nextLocale === locale,
    }));
---

<nav class="language-selector" aria-label="Language">
  {
    links.map((link) => (
      <a href={link.href} aria-current={link.current ? 'page' : undefined} title={link.label}>
        {link.locale.toUpperCase()}
      </a>
    ))
  }
</nav>
