---
import { getLocalizedPath, locales, localeLabels, type LanguageLink, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  languageLinks?: LanguageLink[];
}

const { locale, languageLinks } = Astro.props;
const currentPath = Astro.url.pathname.replace(/^\/(en|ja|zh)(?=\/|$)/, '') || '/';
const links = languageLinks ?? locales.map((nextLocale) => ({
      locale: nextLocale,
      label: localeLabels[nextLocale],
      href: getLocalizedPath(nextLocale, currentPath),
      current: nextLocale === locale,
    }));
---

<label class="language-selector">
  <span class="sr-only">Language</span>
  <select aria-label="Language" data-language-selector>
    {
      links.map((link) => (
        <option value={link.href} selected={link.current}>
          {link.label}
        </option>
      ))
    }
  </select>
</label>

<script>
  for (const selector of document.querySelectorAll<HTMLSelectElement>('[data-language-selector]')) {
    selector.addEventListener('change', () => {
      window.location.href = selector.value;
    });
  }
</script>
