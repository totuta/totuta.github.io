---
import Header from '@components/Header.astro';
import { ui, type LanguageLink, type Locale } from '@lib/i18n';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
  languageLinks?: LanguageLink[];
}

const { title, description, locale, languageLinks } = Astro.props;
const t = ui[locale];
const pageTitle = title ? `${title} | ${t.siteTitle}` : t.siteTitle;
const pageDescription = description ?? t.siteDescription;
const buildId = import.meta.env.PUBLIC_BUILD_ID ?? 'local';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="totuta-build-id" content={buildId} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={t.siteTitle} href="/rss.xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const key = 'totuta:build-id';
          const current = document.querySelector('meta[name="totuta-build-id"]')?.content;
          if (!current) return;

          const previous = localStorage.getItem(key);
          const reloadKey = `${key}:reloaded:${current}`;

          if (previous && previous !== current && !sessionStorage.getItem(reloadKey)) {
            localStorage.setItem(key, current);
            sessionStorage.setItem(reloadKey, 'true');
            window.location.reload();
            return;
          }

          localStorage.setItem(key, current);
        } catch {
          // Ignore storage access errors in private or restricted browsing modes.
        }
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} languageLinks={languageLinks} />
    <main>
      <slot />
    </main>
  </body>
</html>
