---
import PostCard from '@components/PostCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { ui } from '@lib/i18n';
import { getAllBlogPosts, getPostsForLocale } from '@lib/posts';

const locale = 'ko';
const t = ui[locale];
const posts = getPostsForLocale(await getAllBlogPosts(), locale).slice(0, 5);
---

<BaseLayout locale={locale}>
  <section class="hero">
    <h1>{t.siteDescription}</h1>
    <p>AI에게 물어봐도 딱 이해가 안되는 내용들에 대해서.</p>
  </section>

  <section>
    <h2 class="page-title">{t.latestPosts}</h2>
    <div class="post-list">
      {posts.length ? posts.map((post) => <PostCard post={post} locale={locale} />) : <p>{t.noPosts}</p>}
    </div>
  </section>
</BaseLayout>
