---
import BaseLayout from '@layouts/BaseLayout.astro';
import { ui } from '@lib/i18n';

const locale = 'ko';
const t = ui[locale];
---

<BaseLayout title={t.about} locale={locale}>
  <h1 class="page-title">{t.about}</h1>
  <div class="prose">
    <p>AI, 컴퓨터 과학, 머신러닝, 시스템, 소프트웨어 엔지니어링을 공부하고 구현하며 배운 내용을 기록합니다.</p>
  </div>
</BaseLayout>
