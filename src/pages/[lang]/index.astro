---
import PostCard from '@components/PostCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { isLocale, locales, ui, type Locale } from '@lib/i18n';
import { getAllBlogPosts, getPostsForLocale } from '@lib/posts';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== 'ko').map((lang) => ({ params: { lang } }));
}

const locale = isLocale(Astro.params.lang) ? Astro.params.lang : 'ko';
const t = ui[locale];
const posts = getPostsForLocale(await getAllBlogPosts(), locale).slice(0, 5);

const intro: Record<Locale, string> = {
  ko: 'AI에게 물어봐도 딱 이해가 안되는 내용들에 대해서.',
  en: 'For things that still do not quite click, even after asking AI.',
  ja: 'AIに聞いても、いまいち腑に落ちないことについて。',
  zh: '关于那些问了 AI 也还是不太明白的内容。',
};
---

<BaseLayout locale={locale}>
  <section class="hero">
    <h1>{t.siteDescription}</h1>
    <p>{intro[locale]}</p>
  </section>

  <section>
    <h2 class="page-title">{t.latestPosts}</h2>
    <div class="post-list">
      {posts.length ? posts.map((post) => <PostCard post={post} locale={locale} />) : <p>{t.noPosts}</p>}
    </div>
  </section>
</BaseLayout>
