---
import { render } from 'astro:content';
import type { BlogPost } from '@lib/i18n';
import { getAllBlogPosts } from '@lib/posts';
import { getLanguageLinksForPost, getSlugFromId, isLocale, locales, pickPostForLocale } from '@lib/i18n';
import PostLayout from '@layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  const slugs = [...new Set(posts.map((post) => getSlugFromId(post.id)))];
  const nonDefaultLocales = locales.filter((locale) => locale !== 'ko');

  return nonDefaultLocales.flatMap((lang) =>
    slugs.flatMap((slug) => {
      const post = pickPostForLocale(posts, slug, lang);
      return post ? [{ params: { lang, slug }, props: { post } }] : [];
    }),
  );
}

const locale = isLocale(Astro.params.lang) ? Astro.params.lang : 'ko';
const { post } = Astro.props as { post: BlogPost };
const languageLinks = getLanguageLinksForPost(await getAllBlogPosts(), post, locale);
const { Content } = await render(post);
---

<PostLayout post={post} locale={locale} languageLinks={languageLinks}>
  <Content />
</PostLayout>
